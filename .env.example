# Runtime
PLATANIA_ENV=development
PLATANIA_DATA_MODE=auto
PLATANIA_CACHE_DIR=data/cache
PLATANIA_CACHE_TTL_HOURS=24
PLATANIA_CORS_ORIGINS=http://localhost:5173
PLATANIA_LOG_LEVEL=INFO
PLATANIA_PUBLIC_URL=http://localhost:5173
PLATANIA_ADMIN_USER_IDS=

# Market providers. Provider calls happen only in scheduled refresh jobs.
PLATANIA_PROVIDER_MIN_INTERVAL_SECONDS=1.5
PLATANIA_PROVIDER_TIMEOUT_SECONDS=20
PLATANIA_PROVIDER_MAX_RETRIES=3
PLATANIA_REALTIME_CACHE_TTL_SECONDS=90
PLATANIA_REALTIME_DEFAULT_INTERVAL=5
# On cache miss, fetch the selected symbol once and cache it. Browser never calls providers directly.
PLATANIA_ON_DEMAND_LIVE_REFRESH=true

# DeepSeek. Keep API keys only in the server-side .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_DAILY_FREE_LIMIT=3

# Supabase browser-safe values. Copy these two to web/.env.local when enabling Auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy public key name supported by the frontend.
VITE_SUPABASE_ANON_KEY=

# Supabase server-only values. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy server key name supported by the API.
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy compatibility. New projects are verified through Supabase Auth.
SUPABASE_JWT_SECRET=
