# Optional. Regular page loads never call AKShare; use the refresh endpoint explicitly.
PLATANIA_DATA_SOURCE=auto
PLATANIA_CACHE_DIR=data/cache
PLATANIA_CACHE_TTL_HOURS=24
PLATANIA_CORS_ORIGINS=http://localhost:5173

# Reserved for the membership phase. Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

